          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  t.unit_id AS \"Трекер\",\n  t.received_at AS \"Время\",\n  t.speed AS \"Скорость, км/ч\",\n  t.fuel_level_l AS \"Топливо, л\",\n  t.engine_temp AS \"Двигатель, °C\",\n  p.score AS \"Прогноз\"\nFROM (\n  SELECT DISTINCT ON (unit_id) unit_id, received_at, speed, fuel_level_l, engine_temp\n  FROM telemetry\n  WHERE $__timeFilter(received_at) AND unit_id IN ($unit)\n  ORDER BY unit_id, received_at DESC\n) t\nLEFT JOIN LATERAL (\n  SELECT score\n  FROM predictions\n  WHERE unit_id = t.unit_id AND $__timeFilter(received_at)\n  ORDER BY received_at DESC\n  LIMIT 1\n) p ON true\nORDER BY t.unit_id"
        }
